<resources>
    <style name="Theme.Starter" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Starter.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#101318</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Starter</item>
    </style>
    <color name="launcher_background">#101318</color>
</resources>
